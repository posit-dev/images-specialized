# Baked default AWS profile for the Positron SageMaker image.
# Bridges the SageMaker execution role into tools (like the AWS Toolkit) that
# resolve a profile rather than the raw default credential chain. The AWS CLI v2
# `export-credentials` resolves the role via the container-credentials endpoint
# and emits it in the SDK `process` JSON format, refreshing on each call. No
# static credentials are stored here.
# Wired into positron-server via AWS_CONFIG_FILE only when the user has no
# ~/.aws/config (see jupyter_server_config.py).
#
# The `env -u …` prefix is load-bearing: `aws configure export-credentials` runs
# as the credential_process for THIS [default] profile, but the subprocess
# inherits AWS_CONFIG_FILE (pointing back here) and the CLI's internal
# `_AWS_CLI_PROFILE_CHAIN` marker, so it would re-resolve [default] and the CLI
# aborts with "infinite loop, profile cycle: default -> default". Unsetting those
# vars makes the subprocess resolve the container-credentials endpoint directly
# instead of recursing. Absolute paths so it works regardless of the caller's PATH.
[default]
credential_process = /usr/bin/env -u AWS_CONFIG_FILE -u AWS_PROFILE -u _AWS_CLI_PROFILE_CHAIN /usr/local/bin/aws configure export-credentials --format process
