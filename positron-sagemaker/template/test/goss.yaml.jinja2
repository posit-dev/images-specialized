{#-
Below are imports for Bakery's macros. If any are unneeded, they can be removed.
Bakery handles bootstrapping the files into template rendering.
-#}
{%- import "r.j2" as r -%}
{#-
Matches the r_os set in the Containerfile template: Image.OS isn't populated
for an image with no variants, so the P3M repo URL asserted below is built
from the same hardcoded codename rather than a runtime-detected one. Update
alongside the Containerfile if the base image ever moves to a different
Ubuntu release.
-#}
{%- set r_os = {"Name": "ubuntu", "Codename": "noble"} -%}

# Structural checks only (installed versions, files, env vars) -- this image
# runs a full SageMaker Studio JupyterLab app, not a simple service dgoss can
# health-check by port/process, so there's no "wait" needed and no server to
# talk to here. Runtime/launch behavior on the actual SageMaker platform is a
# separate, later concern (posit-dev/platform-team#460).

command:
  # --- positron-server, quarto, R, uv, and python on PATH -------------------
  # uv/python/python3 are additionally asserted to resolve from the base
  # image's conda env (/opt/conda/bin) rather than merely "on PATH somewhere"
  # -- that's where the Dockerfile installs uv (see the pip install RUN
  # block) and where the base image's own Python lives, so a regression that
  # shadowed either with some other interpreter would slip past a bare
  # `which` check.
  positron-server-on-path:
    exec: "which positron-server"
    exit-status: 0
  quarto-on-path:
    exec: "which quarto"
    exit-status: 0
  r-on-path:
    exec: "which R"
    exit-status: 0
  uv-on-path:
    exec: "which uv"
    exit-status: 0
    stdout:
      - "/^\\/opt\\/conda\\/bin\\/uv$/"
  python-on-path:
    exec: "which python"
    exit-status: 0
    stdout:
      - "/^\\/opt\\/conda\\/bin\\/python$/"
  # python3 is checked separately from python: jupyter_server_config.py's
  # license-error fallback server shells out via "/usr/bin/env python3" (not
  # "python"), so python3 specifically must resolve on PATH.
  python3-on-path:
    exec: "which python3"
    exit-status: 0
    stdout:
      - "/^\\/opt\\/conda\\/bin\\/python3$/"

  # --- Installed versions match the pinned values ---------------------------
  # positron-server prints "Positron: <version> build <build>" for a version
  # string of the form "<version>-<build>" (e.g. "2026.07.1-5"); the CDN
  # tarball this image installs is always named with that pattern.
  positron-server-version:
    exec: "positron-server --version"
    exit-status: 0
    stdout:
      - "/^Positron: {{ Image.Version | replace('-', ' build ') }}$/"
  quarto-version:
    exec: "quarto --version"
    exit-status: 0
    stdout:
      - "/^{{ Dependencies.quarto.0 }}$/"
  r-version:
    exec: "R --version"
    exit-status: 0
    # No trailing `$` here (unlike positron-server/quarto above): R's first
    # line has more after the version ("R version 4.6.1 (2026-06-24) -- ..."),
    # so a trailing space stands in for the end anchor instead -- enough to
    # stop "4.6.1" from also matching a future "4.6.10".
    stdout:
      - "/^R version {{ Dependencies.R.0 }} /"

  # --- Verify R packages' system libraries -----------------------------------
  # P3M ships R packages as PREBUILT .so files linked against SYSTEM libraries. A
  # missing one is invisible at build time and only fails at RUNTIME with
  # "unable to load shared object" -- often deep inside an app, far from the
  # cause (e.g. bslib::bs_theme_dependencies pulls in `fs`, so a themed Shiny
  # app died on libuv.so.1 while nothing referenced `fs` directly). This
  # asserts every installed package's .so resolves, so such a gap fails the
  # image test instead of surfacing at runtime.
  #
  # This runs against the fully-built image, so it's naturally after the Pro
  # Drivers install (the `odbc` package needs libodbc.so.2, which unixodbc
  # provides and which the drivers RUN block installs).
  # libR.so is excluded -- ldd cannot resolve it outside a running R session.
  #
  # The libR exclusion is done in awk, NOT `| grep -v '^libR'`, on purpose:
  # under `set -o pipefail` grep exits 1 when it selects no lines -- which is
  # exactly the healthy case here (nothing missing) -- and would false-fail
  # the check. awk exits 0 whether or not it prints, so it is pipefail-safe.
  r-packages-system-libraries-resolve:
    exec: |
      missing="$(find "$(R RHOME)/library" -name '*.so' -exec ldd {} \; 2>/dev/null \
              | awk '/not found/ && $1 !~ /^libR/ {print $1}' | sort -u | tr '\n' ' ')"
      if [ -n "$missing" ]; then
        echo "ERROR: R packages have unresolved system libs: $missing" >&2
        echo "Add the providing apt package(s) to a RUN block in the Containerfile." >&2
        exit 1
      fi
      echo "OK: all R package shared libraries resolve"
    exit-status: 0

  # --- System libs for R packages users install themselves --------------------
  # The check above only scans $(R RHOME)/library -- the SYSTEM R library, i.e.
  # the packages this image installs. It is blind to packages a user installs
  # into their own library, which on SageMaker is the persistent home at
  # /home/sagemaker-user/R/x86_64-pc-linux-gnu-library/4.6. That blind spot is
  # exactly how the `magick` gap shipped: nothing in the system library links
  # against libMagick++, so the image tested clean while every plot an agent
  # rendered through `commons` died at runtime on
  # "libMagick++-6.Q16.so.9: cannot open shared object file".
  #
  # `commons` (posit-dev/commons) Imports `magick`, so assert the SONAMEs its
  # P3M binary needs are resolvable image-wide. ldconfig -p is the right probe
  # precisely BECAUSE there is no R package here to run ldd against -- this
  # guards a lib installed for a package the image does not itself ship.
  # Counted with awk, not `grep -c`, for the same pipefail reason called out
  # above: grep exits 1 when it matches nothing -- the very case this check
  # exists to report -- which under `set -o pipefail` would abort the exec
  # before the diagnostic below could print. awk always exits 0.
  imagemagick-system-libraries-resolve:
    exec: |
      found="$(ldconfig -p \
              | awk '/libMagick(\+\+|Wand|Core)-6\.Q16\.so/ {n++} END {print n+0}')"
      if [ "$found" -lt 3 ]; then
        echo "ERROR: expected libMagick++/libMagickWand/libMagickCore in ldconfig, found $found" >&2
        echo "Install libmagick++-6.q16-9t64 in the System packages RUN block." >&2
        ldconfig -p | grep -i magick >&2 || true
        exit 1
      fi
      echo "OK: ImageMagick 6 Q16 shared libraries resolve ($found found)"
    exit-status: 0

  # --- No Jupyter kernel exists (Positron-only launcher) ---------------------
  # Mirrors the build-time assertion in the Containerfile: every kernels/ dir
  # under Jupyter's data paths was removed, and the synthetic "python3" kernel
  # ipykernel always exposes is suppressed via ensure_native_kernel=False.
  no-jupyter-kernelspecs:
    exec: "jupyter kernelspec list --json --KernelSpecManager.ensure_native_kernel=False"
    exit-status: 0
    stdout:
      - '"kernelspecs": {}'

  # --- Required environment variables ----------------------------------------
  # ODBCSYSINI: forces R odbc/Python pyodbc to read /etc/odbcinst.ini (the Pro
  # Drivers registration) instead of a conda-shipped driver manager's config.
  odbcsysini-env:
    exec: "printenv ODBCSYSINI"
    exit-status: 0
    stdout:
      - "/etc"
  # JSP_POSITRON_LAUNCHER_DISABLED: suppresses jupyter-positron-server's own
  # duplicate launcher tile in favor of the one registered in
  # jupyter_server_config.py.
  jsp-positron-launcher-disabled-env:
    exec: "printenv JSP_POSITRON_LAUNCHER_DISABLED"
    exit-status: 0
    stdout:
      - "1"

user:
  # --- The runtime user's uid/gid stay pinned to the base image's default ---
  # This is the identity the jupyter-server, and therefore positron-server and
  # the License Manager client, run as -- the client checks a seat out under the
  # Space's execution role at runtime, so the runtime user matters. `owner`/
  # `group` on file resources only assert the NAMES resolve, so pin the
  # underlying ids here too in case the base image ever changes what
  # "sagemaker-user"/"users" map to.
  sagemaker-user:
    exists: true
    uid: 1000
    gid: 100

group:
  users:
    exists: true
    gid: 100

file:
  # --- AWS License Manager client --------------------------------------------
  # This binary is the image's ONLY licensing mechanism: jupyter_server_config.py
  # points positron-server at it via POSITRON_LICENSE_MANAGER_PATH, and
  # positron-server takes that client's verdict as the licensing decision. If it
  # is missing, the config serves a license-error page and nobody can run
  # Positron -- so assert it is installed and executable rather than discovering
  # a silently failed download in a live Space.
  /usr/lib/positron-server/bin/license-manager-aws-sagemaker:
    exists: true
    filetype: file
    mode: "0755"

  # --- Rprofile.site contains the P3M repository and HTTPUserAgent lines ----
  # r.j2's install() does not write this file; it's written by hand in the
  # Containerfile and asserted here byte-for-byte against the same macro call
  # used to generate it.
  {{ r.get_version_directory(Dependencies.R.0) }}/lib/R/etc/Rprofile.site:
    exists: true
    filetype: file
    contents:
      - 'options(repos = c(P3M = "{{ r.get_p3m_cran_repo(r_os) }}"))'
      - 'options(HTTPUserAgent = sprintf("R/%s R (%s)", getRversion(), paste(getRversion(), R.version["platform"], R.version["arch"], R.version["os"])))'

  # --- AWS Toolkit extension is present ---------------------------------------
  /opt/positron-server/extensions/amazonwebservices.aws-toolkit-vscode/package.json:
    exists: true
    filetype: file

  # --- ODBC driver entries are registered, and the driver file exists --------
  # Matched against full driver paths rather than bare `[SectionName]`
  # headers: goss's `contents` only treats a string as a regex when wrapped in
  # `/.../`, so brackets aren't actually a parsing hazard here, but the
  # odbcinst.ini we append this to (rstudio-drivers' odbcinst.ini.sample)
  # lists every supported vendor, not just the three used by this image -- the
  # full driver path is unambiguous either way.
  /etc/odbcinst.ini:
    exists: true
    filetype: file
    contents:
      - Driver = /opt/rstudio-drivers/athena/bin/lib/libathenaodbc_sb64.so
      - Driver = /opt/rstudio-drivers/snowflake/bin/lib/libsnowflakeodbc_sb64.so
      - Driver = /opt/rstudio-drivers/redshift/bin/lib/libamazonredshiftodbc_sb64.so
  # Athena, Snowflake, and Redshift are the drivers actually exercised by this
  # image (README.md); check all three .so files exist, not just Athena's.
  /opt/rstudio-drivers/athena/bin/lib/libathenaodbc_sb64.so:
    exists: true
    filetype: file
  /opt/rstudio-drivers/snowflake/bin/lib/libsnowflakeodbc_sb64.so:
    exists: true
    filetype: file
  /opt/rstudio-drivers/redshift/bin/lib/libamazonredshiftodbc_sb64.so:
    exists: true
    filetype: file

  # --- Posit Assistant enforced settings: enabled, and the Bedrock model
  # placeholder was actually substituted (positron-sagemaker
  # docs/design-native-image.md: "Verify the exact enforced-settings contract
  # at build time"). The exact model id isn't asserted here -- it's a
  # Dockerfile ARG default, not a Bakery-tracked value -- only that the sed
  # substitution ran. Checked with a `!`-prefixed negative matcher directly in
  # `contents` (a plain or regex string prefixed with `!` asserts the pattern
  # is ABSENT), rather than a separate command check.
  /etc/positron/enforced-settings.json:
    exists: true
    filetype: file
    contents:
      - '"positron.assistant.enable": true'
      - '"positron.assistant.provider.amazonBedrock.enable": true'
      - '!__POSITRON_BEDROCK_MODEL__'

  # --- Baked AWS credential-bridge profile exists ----------------------------
  # See README.md "AWS credential bridge (design)": wires the execution role
  # into tools (AWS Toolkit) that resolve a profile instead of the raw default
  # credential chain. Matched against the full credential_process directive
  # rather than the bare "[default]" header, since both "[default]" and
  # "credential_process" already appear verbatim in this file's own comments
  # and would pass a substring check on the comment block alone.
  /etc/positron/aws-config:
    exists: true
    filetype: file
    contents:
      - "credential_process = /usr/bin/env -u AWS_CONFIG_FILE -u AWS_PROFILE -u _AWS_CLI_PROFILE_CHAIN /usr/local/bin/aws configure export-credentials --format process"
