{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/positron-sagemaker\\/.+\\/Containerfile\\.ubuntu2404(\\.jinja2)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+FROM [^\\s]+:(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-cpu$"
    }
  ],
  "dependencyDashboard": false,
  "enabledManagers": [
    "custom.regex"
  ],
  "onboarding": false
}
